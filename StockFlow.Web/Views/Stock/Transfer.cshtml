@model StockTransferViewModel

@{
    ViewData["Title"] = "Transferência entre armazéns";
}

<h1>Transferência entre armazéns</h1>

<h4>Movimentar estoque entre armazéns</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Transfer" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="ProductVariantId" class="control-label"></label>
                <select asp-for="ProductVariantId" asp-items="Model.VariantOptions" class="form-select">
                    <option value="">Selecione uma variante</option>
                </select>
                <span asp-validation-for="ProductVariantId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="FromWarehouseId" class="control-label"></label>
                <select asp-for="FromWarehouseId" asp-items="Model.WarehouseOptions" class="form-select">
                    <option value="">Selecione o armazém de origem</option>
                </select>
                <span asp-validation-for="FromWarehouseId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ToWarehouseId" class="control-label"></label>
                <select asp-for="ToWarehouseId" asp-items="Model.WarehouseOptions" class="form-select">
                    <option value="">Selecione o armazém de destino</option>
                </select>
                <span asp-validation-for="ToWarehouseId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Transferir" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}