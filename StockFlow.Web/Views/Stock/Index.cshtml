@using System.Text.Json
@model IReadOnlyList<StockItemViewModel>

@{
    ViewData["Title"] = "Estoque";

    var chartLabels = Model
        .Select(item => $"{item.ProductVariant?.Sku ?? item.ProductVariantId.ToString()} - {item.Warehouse?.Name ?? item.WarehouseId.ToString()}")
        .ToList();

    var chartData = Model
        .Select(item => item.Quantity)
        .ToList();
}

<h1>Estoque</h1>

<p>
    <a asp-action="Create">Nova movimentação</a>
</p>
@if (Model.Count > 0)
{
    <div class="mb-4">
        <h2 class="h5">Quantidade em estoque</h2>
        <canvas id="stockChart"></canvas>
    </div>
}
@if (Model.Count == 0)
{
    <p>Nenhum item em estoque.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Variante</th>
                <th>Armazém</th>
                <th>Quantidade</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stockItem in Model)
            {
                <tr>
                    <td>
                        @($"{stockItem.ProductVariant?.Size} - {stockItem.ProductVariant?.Color} - {stockItem.ProductVariant?.Sku}")
                    </td>

                    <td>
                        @(stockItem.Warehouse?.Name ?? stockItem.WarehouseId.ToString())
                    </td>

                    <td>
                        @stockItem.Quantity

                        @if (stockItem.Quantity <= stockItem.ProductVariant?.MinimumStockLevel)
                        {
                            <span style="color: red;"> - Estoque baixo</span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details" asp-route-productVariantId="@stockItem.ProductVariantId">Movimentações</a> |
                        <a asp-action="Create" asp-route-productVariantId="@stockItem.ProductVariantId" asp-route-warehouseId="@stockItem.WarehouseId">Movimentar</a> |
                        <a asp-action="Transfer" asp-route-productVariantId="@stockItem.ProductVariantId" asp-route-fromWarehouseId="@stockItem.WarehouseId">Transferir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(JsonSerializer.Serialize(chartLabels));
        const data = @Html.Raw(JsonSerializer.Serialize(chartData));

        new Chart(document.getElementById('stockChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Quantidade',
                    data
                }]
            }
        });
    </script>
}