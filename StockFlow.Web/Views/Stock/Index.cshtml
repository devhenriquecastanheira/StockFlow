@model IReadOnlyList<StockItemViewModel>

@{
    ViewData["Title"] = "Estoque";
}

<h1>Estoque</h1>

<p>
    <a asp-action="Create">Nova movimentação</a>
</p>

@if (Model.Count == 0)
{
    <p>Nenhum item em estoque.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Variante</th>
                <th>Armazém</th>
                <th>Quantidade</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stockItem in Model)
            {
                <tr>
                    <td>
                        @($"{stockItem.ProductVariant?.Size} - {stockItem.ProductVariant?.Color} - {stockItem.ProductVariant?.Sku}")
                    </td>

                    <td>
                        @(stockItem.Warehouse?.Name ?? stockItem.WarehouseId.ToString())
                    </td>

                    <td>
                        @stockItem.Quantity

                        @if (stockItem.Quantity <= stockItem.ProductVariant?.MinimumStockLevel)
                        {
                            <span style="color: red;"> - Estoque baixo</span>
                        }
                    </td>

                    <td>
                        <a asp-action="Details" asp-route-productVariantId="@stockItem.ProductVariantId">Movimentações</a> |
                        <a asp-action="Create" asp-route-productVariantId="@stockItem.ProductVariantId" asp-route-warehouseId="@stockItem.WarehouseId">Movimentar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}