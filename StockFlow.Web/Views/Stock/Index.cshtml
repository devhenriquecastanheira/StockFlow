@using System.Text.Json
@model IReadOnlyList<StockItemViewModel>

@{
    ViewData["Title"] = "Estoque";

    var chartLabels = Model
        .Select(item => $"{item.ProductVariant?.Sku ?? item.ProductVariantId.ToString()} - {item.Warehouse?.Name ?? item.WarehouseId.ToString()}")
        .ToList();

    var chartData = Model
        .Select(item => item.Quantity)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Estoque</h1>
    <a asp-action="Create" class="btn btn-primary">Nova movimentação</a>
</div>

@if (Model.Count > 0)
{
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">Quantidade em estoque</h2>
            <canvas id="stockChart"></canvas>
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="mb-0">Nenhum item em estoque.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Variante</th>
                <th>Armazém</th>
                <th>Quantidade</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stockItem in Model)
            {
                <tr>
                    <td>
                        @($"{stockItem.ProductVariant?.Size} - {stockItem.ProductVariant?.Color} - {stockItem.ProductVariant?.Sku}")
                    </td>

                    <td>
                        @(stockItem.Warehouse?.Name ?? stockItem.WarehouseId.ToString())
                    </td>

                    <td>
                        @stockItem.Quantity

                        @if (stockItem.Quantity <= stockItem.ProductVariant?.MinimumStockLevel)
                        {
                            <span class="text-danger"> - Estoque baixo</span>
                        }
                    </td>

                    <td class="text-end">
                        <a asp-action="Details" asp-route-productVariantId="@stockItem.ProductVariantId" class="btn btn-sm btn-outline-secondary">Movimentações</a>
                        <a asp-action="Create" asp-route-productVariantId="@stockItem.ProductVariantId" asp-route-warehouseId="@stockItem.WarehouseId" class="btn btn-sm btn-secondary">Movimentar</a>
                        <a asp-action="Transfer" asp-route-productVariantId="@stockItem.ProductVariantId" asp-route-fromWarehouseId="@stockItem.WarehouseId" class="btn btn-sm btn-secondary">Transferir</a>
                    </td>
                </tr>
            }
        </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const labels = @Html.Raw(JsonSerializer.Serialize(chartLabels));
        const data = @Html.Raw(JsonSerializer.Serialize(chartData));

        new Chart(document.getElementById('stockChart'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Quantidade',
                    data
                }]
            }
        });
    </script>
}
