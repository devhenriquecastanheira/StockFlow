@model IReadOnlyList<StockMovementViewModel>

@{
    ViewData["Title"] = "Movimentações";
    var productVariantId = (int)ViewBag.ProductVariantId;
    var productVariantName = ViewBag.ProductVariantName as string ?? productVariantId.ToString();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Movimentações</h1>
        <p class="mb-0 text-secondary">@productVariantName</p>
    </div>
    <a asp-action="Create" asp-route-productVariantId="@productVariantId" class="btn btn-primary">Nova movimentação</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="mb-0">Nenhuma movimentação encontrada.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Data</th>
                <th>Armazém</th>
                <th>Tipo</th>
                <th>Quantidade</th>
                <th>Motivo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movement in Model)
            {
                <tr>
                    <td>@movement.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>@movement.WarehouseName</td>
                    <td>@GetMovementTypeName(movement.Type)</td>
                    <td>@movement.Quantity</td>
                    <td>@(string.IsNullOrWhiteSpace(movement.Reason) ? "-" : movement.Reason)</td>
                </tr>
            }
        </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

@functions {
    private static string GetMovementTypeName(StockMovementTypeViewModel type)
    {
        return type switch
        {
            StockMovementTypeViewModel.Entry => "Entrada",
            StockMovementTypeViewModel.Exit => "Saída",
            StockMovementTypeViewModel.Adjustment => "Ajuste",
            _ => type.ToString()
        };
    }
}
