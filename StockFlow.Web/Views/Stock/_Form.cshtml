@model StockMovementViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="form-group mb-3">
    <label asp-for="ProductVariantId" class="control-label"></label>
    <input asp-for="ProductVariantId" class="form-control" type="number" min="1" />
    <span asp-validation-for="ProductVariantId" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="WarehouseId" class="control-label"></label>
    <input asp-for="WarehouseId" class="form-control" type="number" min="1" />
    <span asp-validation-for="WarehouseId" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Type" class="control-label"></label>
    <select asp-for="Type" asp-items="ViewBag.MovementTypeOptions" class="form-select"></select>
    <span asp-validation-for="Type" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Quantity" class="control-label"></label>
    <input asp-for="Quantity" class="form-control" type="number" min="1" />
    <span asp-validation-for="Quantity" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Reason" class="control-label"></label>
    <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Reason" class="text-danger"></span>
</div>
