@model IReadOnlyList<ProductViewModel>

@{
    ViewData["Title"] = "Produtos";
}

<h1>Produtos</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Operador"))
{
    <p>
        <a asp-action="Create">Novo produto</a>
    </p>
}
else if (User.IsInRole("Cliente"))
{
    <p>
        <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">Iniciar carrinho</a>
    </p>
}

@if (Model.Count == 0)
{
    <p>Nenhum produto cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Categoria</th>
                @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                {
                    <th>Preço de custo</th>
                }
                <th>Preço de venda</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td class="fw-medium">@product.Name</td>
                    <td class="text-secondary">@product.CategoryName</td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <td>@product.CostPrice.ToString("C")</td>
                    }
                    <td>@product.SalePrice.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.Id">Detalhes</a> |
                        <a asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@product.Id">Variantes</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <span>|</span>
                            <a asp-action="Edit" asp-route-id="@product.Id">Editar</a>
                            <span>|</span>
                            <a asp-action="Delete" asp-route-id="@product.Id">Excluir</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
