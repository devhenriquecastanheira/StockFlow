@model IReadOnlyList<ProductViewModel>

@{
    ViewData["Title"] = "Produtos";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? string.Empty;
}

<h1>Produtos</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Operador"))
{
    <p>
        <a asp-action="Create">Novo produto</a>
    </p>
}
else if (User.IsInRole("Cliente"))
{
    <p>
        <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">Ver carrinho</a>
    </p>
}

@if (Model.Count == 0)
{
    <p>Nenhum produto cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Tags</th>
                @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                {
                    <th>Preço de custo</th>
                }
                <th>Preço de venda</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                var images = product.Images ?? [];
                var mainImage = images.FirstOrDefault(image => image.IsMain) ?? images.FirstOrDefault();

                <tr>
                    <td>
                        @if (mainImage is not null)
                        {
                            <img src="@(apiBaseUrl + mainImage.ImageUrl)" alt="@product.Name" style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-secondary">Sem imagem</span>
                        }
                    </td>
                    <td class="fw-medium">@product.Name</td>
                    <td class="text-secondary">@product.CategoryName</td>
                    <td>
                        @if (product.Tags.Count == 0)
                        {
                            <span class="text-secondary">-</span>
                        }
                        else
                        {
                            foreach (var tag in product.Tags)
                            {
                                <span class="badge text-bg-secondary me-1">@tag.Name</span>
                            }
                        }
                    </td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <td>@product.CostPrice.ToString("C")</td>
                    }
                    <td>@product.SalePrice.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@product.Id">Detalhes</a> |
                        <a asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@product.Id">Ver opções</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <span>|</span>
                            <a asp-action="Edit" asp-route-id="@product.Id">Editar</a>
                            <span>|</span>
                            <a asp-action="Delete" asp-route-id="@product.Id">Excluir</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
