@model ProductViewModel

@{
    ViewData["Title"] = "Excluir produto";
}

<h1>Excluir produto</h1>

<h3>Tem certeza que deseja excluir este registro?</h3>
<div>
    <h4>Produto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Descrição</dt>
        <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        <dt class="col-sm-2">Categoria</dt>
        <dd class="col-sm-10">@Model.CategoryName</dd>
        <dt class="col-sm-2">Preço de custo</dt>
        <dd class="col-sm-10">@Model.CostPrice.ToString("C")</dd>
        <dt class="col-sm-2">Preço de venda</dt>
        <dd class="col-sm-10">@Model.SalePrice.ToString("C")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar</a>
    </form>
</div>
