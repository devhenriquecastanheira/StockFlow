@model ProductViewModel

@{
    ViewData["Title"] = "Detalhes";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? string.Empty;
    var images = Model.Images ?? [];
}

<h1>Detalhes</h1>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div>
    <h4>Produto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Descrição</dt>
        <dd class="col-sm-10">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        <dt class="col-sm-2">Categoria</dt>
        <dd class="col-sm-10">@Model.CategoryName</dd>
        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
        {
            <dt class="col-sm-2">Preço de custo</dt>
            <dd class="col-sm-10">@Model.CostPrice.ToString("C")</dd>
        }
        <dt class="col-sm-2">Preço de venda</dt>
        <dd class="col-sm-10">@Model.SalePrice.ToString("C")</dd>
    </dl>
</div>

<div class="mb-3">
    <h4>Tags</h4>

    @if (Model.Tags.Count == 0)
    {
        <p>Nenhuma tag associada.</p>
    }
    else
    {
        <div class="mb-3">
            @foreach (var tag in Model.Tags)
            {
                <span class="badge text-bg-secondary me-1 mb-1">@tag.Name</span>

                @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                {
                    <form asp-action="RemoveTag" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="tagId" value="@tag.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger me-2 mb-1">Remover</button>
                    </form>
                }
            }
        </div>
    }

    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        @if (Model.TagOptions.Count == 0)
        {
            <p class="text-secondary">Não há tags disponíveis para adicionar.</p>
        }
        else
        {
            <form asp-action="AddTag" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="col-md-4">
                    <label for="tagId" class="form-label">Adicionar tag</label>
                    <select id="tagId" name="tagId" asp-items="Model.TagOptions" class="form-select">
                        <option value="">Selecione</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">Adicionar</button>
                </div>
            </form>
        }
    }
</div>

<div class="mb-3">
    <h4>Imagens</h4>

    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data" class="mb-3">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="file" name="imageFile" class="form-control mb-2" />
            <div class="form-check mb-2">
                <input type="checkbox" name="isMain" value="true" class="form-check-input" id="isMain" />
                <label class="form-check-label" for="isMain">Imagem principal</label>
            </div>
            <button type="submit" class="btn btn-primary">Enviar imagem</button>
        </form>
    }

    @if (images.Count == 0)
    {
        <p>Nenhuma imagem cadastrada.</p>
    }
    else
    {
        <div class="row">
            @foreach (var image in images)
            {
                <div class="col-md-3 mb-3">
                    <img src="@(apiBaseUrl + image.ImageUrl)" alt="@Model.Name" class="img-fluid mb-2" />
                    <div>@(image.IsMain ? "Principal" : "Imagem")</div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <form asp-action="SetMainImage" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <button type="submit" class="btn btn-sm btn-secondary">Principal</button>
                        </form>

                        <form asp-action="DeleteImage" method="post" class="d-inline">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                        </form>
                    }
                </div>
            }
        </div>
    }
</div>

<div>
    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <span>|</span>
    }
    <a asp-controller="ProductVariants" asp-action="Index" asp-route-productId="@Model.Id">Variantes</a> |
    <a asp-action="Index">Voltar</a>
</div>
