@model CartViewModel

@{
    ViewData["Title"] = "Carrinho";
}

<h1>Carrinho</h1>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (Model.Items.Count == 0)
{
    <p>Seu carrinho está vazio.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Continuar comprando</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Tamanho</th>
                <th>Cor</th>
                <th>Quantidade</th>
                <th class="text-end">Preço</th>
                <th class="text-end">Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Size</td>
                    <td>@item.Color</td>
                    <td>
                        <form asp-action="UpdateItem" method="post" class="d-flex gap-2">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width: 90px;" />
                            <button type="submit" class="btn btn-sm btn-secondary">Atualizar</button>
                        </form>
                    </td>
                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                    <td class="text-end fw-bold">@item.SubTotal.ToString("C")</td>
                    <td>
                        <form asp-action="RemoveItem" method="post">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Remover</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-3 text-end">
        <strong>Total: @Model.Total.ToString("C")</strong>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continuar comprando</a>
        <a asp-action="Checkout" class="btn btn-primary">Finalizar compra</a>

        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline-danger">Limpar carrinho</button>
        </form>
    </div>
}
