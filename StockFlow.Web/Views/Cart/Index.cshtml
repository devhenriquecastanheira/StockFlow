@model CartViewModel

@{
    ViewData["Title"] = "Carrinho";
}

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<h1>Itens do carrinho</h1>

@if (Model.Items.Count == 0)
{
    <p>Seu carrinho está vazio.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Continuar comprando</a>
}
else
{
    <div class="row">
        <div class="col-md-8">

            @foreach (var item in Model.Items)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h5>@item.ProductName</h5>
                        <p>Tamanho: @item.Size | Cor: @item.Color</p>
                        <p>Preço: @item.UnitPrice.ToString("C")</p>
                        <p><strong>Subtotal: @item.SubTotal.ToString("C")</strong></p>

                        <form asp-action="UpdateItem" method="post" class="mb-2">
                            <input type="hidden" name="itemId" value="@item.Id" />

                            <label for="quantity-@item.Id">Quantidade</label>
                            <input id="quantity-@item.Id" type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="max-width: 100px;" />

                            <button type="submit" class="btn btn-secondary mt-2">Atualizar</button>
                        </form>

                        <form asp-action="RemoveItem" method="post">
                            <input type="hidden" name="itemId" value="@item.Id" />
                            <button type="submit" class="btn btn-outline-danger">Remover</button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h4>Resumo do pedido</h4>

                    <p>Produtos: @Model.Items.Count</p>
                    <p><strong>Total: @Model.Total.ToString("C")</strong></p>

                    <a asp-action="Checkout" class="btn btn-primary">Finalizar compra</a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Continuar comprando</a>

                    <form asp-action="Clear" method="post" class="mt-2">
                        <button type="submit" class="btn btn-outline-danger">Limpar carrinho</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
