@model IReadOnlyList<WarehouseViewModel>

@{
    ViewData["Title"] = "Armazéns";
}

<h1>Armazéns</h1>

<p>
    <a asp-action="Create">Novo armazém</a>
</p>

@if (Model.Count == 0)
{
    <p>Nenhum armazém cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Localização</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var warehouse in Model)
            {
                <tr>
                    <td class="fw-medium">@warehouse.Name</td>
                    <td class="text-secondary">@warehouse.Location</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@warehouse.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@warehouse.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@warehouse.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}