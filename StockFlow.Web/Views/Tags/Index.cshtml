@model IReadOnlyList<TagViewModel>

@{
    ViewData["Title"] = "Tags";
}

<h1>Tags</h1>

<p>
    <a asp-action="Create">Nova tag</a>
</p>

@if (Model.Count == 0)
{
    <p>Nenhuma tag cadastrada.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tag in Model)
            {
                <tr>
                    <td class="fw-medium">@tag.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@tag.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@tag.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@tag.Id">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}