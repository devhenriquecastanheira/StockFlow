@model IReadOnlyList<SupplierViewModel>

@{
    ViewData["Title"] = "Fornecedores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Fornecedores</h1>
    <a asp-action="Create" class="btn btn-primary">Novo fornecedor</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="mb-0">Nenhum fornecedor cadastrado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Telefone</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td class="fw-medium">@supplier.Name</td>
                    <td class="text-secondary">@supplier.Email</td>
                    <td class="text-secondary">@supplier.Phone</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-secondary">Editar</a>
                        <a asp-action="Details" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                        <a asp-action="Delete" asp-route-id="@supplier.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
                </table>
            </div>
        }
    </div>
</div>
