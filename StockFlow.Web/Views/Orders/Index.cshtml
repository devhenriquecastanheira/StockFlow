@model IReadOnlyList<OrderViewModel>

@{
    ViewData["Title"] = "Pedidos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Pedidos</h1>
    <a asp-action="Create" class="btn btn-primary">Iniciar checkout</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="mb-0">Nenhum pedido cadastrado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nome do Cliente</th>
                <th>Email do Cliente</th>
                <th>Status</th>
                <th>Data de Criação</th>
                <th>Total</th>
                <th class="text-end"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td class="fw-medium">@order.CustomerName</td>
                    <td class="text-secondary">@(string.IsNullOrWhiteSpace(order.CustomerEmail) ? "-" : order.CustomerEmail)</td>
                    <td class="text-secondary">@order.Status</td>
                    <td class="text-secondary">@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-end fw-bold">R$ @order.Total.ToString("F2")</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-secondary">Editar</a>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Revisar carrinho</a>
                        <a asp-action="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
                </table>
            </div>
        }
    </div>
</div>
