@model OrderViewModel

@{
    ViewData["Title"] = "Remover item";
}

<h1>Remover item</h1>

<div>
    <h4>Pedido</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome do Cliente</dt>
        <dd class="col-sm-10">@Model.CustomerName</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@GetMovementTypeName(Model.Status)</dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10 fw-bold">R$ @Model.Total.ToString("F2")</dd>
    </dl>

    @if (Model.Items.Count == 0)
    {
        <p>Nenhum item adicionado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Produto</th>
                    <th>Tamanho</th>
                    <th>Cor</th>
                    <th class="text-end">Quantidade</th>
                    <th class="text-end">Preço unitário</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.ProductName</td>
                        <td>@item.Size</td>
                        <td>@item.Color</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">R$ @item.UnitPrice.ToString("F2")</td>
                        <td class="text-end fw-bold">R$ @item.SubTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <form asp-action="RemoveItem" method="post">
        <input type="hidden" name="orderId" value="@Model.Id" />
        <input type="hidden" name="itemId" value="@Model.Items.First().Id" />
        <input type="submit" value="Remover" class="btn btn-danger" /> |
        <a asp-action="Details" asp-route-id="@Model.Id">Voltar</a>
    </form>
</div>

@functions {
    private static string GetMovementTypeName(OrderStatusViewModel type)
    {
        return type switch
        {
            OrderStatusViewModel.Pending => "Pendente",
            OrderStatusViewModel.Confirmed => "Confirmado",
            OrderStatusViewModel.Shipped => "Enviado",
            OrderStatusViewModel.Delivered => "Entregue",
            _ => type.ToString()
        };
    }
}