@model OrderViewModel

@{
    ViewData["Title"] = "Excluir pedido";
}

<h1>Excluir pedido</h1>

<div class="card">
    <div class="card-body">
        <h3>Tem certeza que deseja excluir este pedido?</h3>
        <h4>Pedido</h4>
        <hr />
        <dl class="row">
        <dt class="col-sm-2">Nome do Cliente</dt>
        <dd class="col-sm-10">@Model.CustomerName</dd>
        <dt class="col-sm-2">Email do Cliente</dt>
        <dd class="col-sm-10">@Model.CustomerEmail</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@GetMovementTypeName(Model.Status)</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

@functions {
    private static string GetMovementTypeName(OrderStatusViewModel type)
    {
        return type switch
        {
            OrderStatusViewModel.Pending => "Pendente",
            OrderStatusViewModel.Confirmed => "Confirmado",
            OrderStatusViewModel.Shipped => "Enviado",
            OrderStatusViewModel.Delivered => "Entregue",
            _ => type.ToString()
        };
    }
}
