@model IReadOnlyList<OrderViewModel>

@{
    ViewData["Title"] = "Minhas compras";
}

<h1>Minhas compras</h1>

@if (Model.Count == 0)
{
    <p>Você ainda não fez nenhuma compra.</p>
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Ver catálogo</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Pedido</th>
                <th>Data</th>
                <th>Status</th>
                <th>Itens</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var quantity = order.Items.Sum(item => item.Quantity);
                var quantityLabel = quantity == 1 ? "item" : "itens";
                var preview = string.Join(", ", order.Items.Take(3).Select(item => item.ProductName));
                if (order.Items.Count > 3)
                {
                    preview += "...";
                }

                <tr>
                    <td class="fw-medium">#@order.Id</td>
                    <td class="text-secondary">@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-secondary">@GetOrderStatusName(order.Status)</td>
                    <td>
                        <span>@quantity @quantityLabel</span>
                        @if (!string.IsNullOrWhiteSpace(preview))
                        {
                            <div class="text-secondary small">@preview</div>
                        }
                    </td>
                    <td class="text-end fw-bold">@order.Total.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-secondary">Detalhes</a>
                        @if (order.Invoice is not null)
                        {
                            <a asp-action="Invoice" asp-route-orderId="@order.Id" class="btn btn-sm btn-outline-secondary">Fatura</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    private static string GetOrderStatusName(OrderStatusViewModel status)
    {
        return status switch
        {
            OrderStatusViewModel.Pending => "Pendente",
            OrderStatusViewModel.Confirmed => "Confirmado",
            OrderStatusViewModel.Shipped => "Enviado",
            OrderStatusViewModel.Delivered => "Entregue",
            _ => status.ToString()
        };
    }
}
