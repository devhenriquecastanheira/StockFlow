@model OrderViewModel

@{
    ViewData["Title"] = "Revisar carrinho";
}

<h1>Revisar carrinho</h1>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div>
    <h4>Dados do pedido</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nome do Cliente</dt>
        <dd class="col-sm-10">@Model.CustomerName</dd>
        <dt class="col-sm-2">Email do Cliente</dt>
        <dd class="col-sm-10">@Model.CustomerEmail</dd>
        <dt class="col-sm-2">Entrega</dt>
        <dd class="col-sm-10">
            @if (string.IsNullOrWhiteSpace(Model.DeliveryStreet))
            {
                <span>-</span>
            }
            else
            {
                <span>@Model.DeliveryStreet, @Model.DeliveryNumber - @Model.DeliveryCity/@Model.DeliveryState</span>
            }
        </dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@GetMovementTypeName(Model.Status)</dd>
        <dt class="col-sm-2">Data de Criação</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10 fw-bold">R$ @Model.Total.ToString("F2")</dd>
    </dl>

    @if (Model.Status == OrderStatusViewModel.Pending)
    {
        <form asp-action="ConfirmOrder" asp-route-orderId="@Model.Id" method="post" style="display:inline">
            <button type="submit" class="btn btn-primary">Finalizar compra</button>
        </form>
    }

    @if (Model.Items.Count == 0)
    {
        <p>Nenhum item adicionado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Tamanho</th>
                    <th>Cor</th>
                    <th class="text-end">Quantidade</th>
                    <th class="text-end">Preço unitário</th>
                    <th class="text-end">Subtotal</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Size</td>
                        <td>@item.Color</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">R$ @item.UnitPrice.ToString("F2")</td>
                        <td class="text-end fw-bold">R$ @item.SubTotal.ToString("F2")</td>
                        <td>
                            @if (Model.Status == OrderStatusViewModel.Pending)
                            {
                                <a asp-action="RemoveItem" asp-route-orderId="@Model.Id" asp-route-itemId="@item.Id">Remover</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<div>
    @if (Model.Status == OrderStatusViewModel.Pending)
    {
        <a asp-action="AddItem" asp-route-orderId="@Model.Id">Adicionar item</a>
        <span>|</span>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <span>|</span>
        <a asp-action="Index">Voltar</a>
    }
    else
    {
        <a asp-controller="Products" asp-action="Index">Voltar ao catálogo</a>
    }
</div>

@functions {
    private static string GetMovementTypeName(OrderStatusViewModel type)
    {
        return type switch
        {
            OrderStatusViewModel.Pending => "Pendente",
            OrderStatusViewModel.Confirmed => "Confirmado",
            OrderStatusViewModel.Shipped => "Enviado",
            OrderStatusViewModel.Delivered => "Entregue",
            _ => type.ToString()
        };
    }
}
