@model OrderViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<input type="hidden" asp-for="CustomerProfileId" />
<input type="hidden" asp-for="DeliveryAddressId" />

<div class="form-group mb-3">
    <label asp-for="CustomerName" class="control-label"></label>
    <input asp-for="CustomerName" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="CustomerName" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="CustomerEmail" class="control-label"></label>
    <input asp-for="CustomerEmail" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
</div>

<h5 class="mt-4">Endereco de entrega</h5>

<div class="form-group mb-3">
    <label asp-for="DeliveryStreet" class="control-label"></label>
    <input asp-for="DeliveryStreet" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="DeliveryStreet" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="DeliveryNumber" class="control-label"></label>
    <input asp-for="DeliveryNumber" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="DeliveryNumber" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="DeliveryCity" class="control-label"></label>
    <input asp-for="DeliveryCity" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="DeliveryCity" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="DeliveryState" class="control-label"></label>
    <input asp-for="DeliveryState" class="form-control" autocomplete="off" readonly="@(User.IsInRole("Cliente") ? "readonly" : null)" />
    <span asp-validation-for="DeliveryState" class="text-danger"></span>
</div>
