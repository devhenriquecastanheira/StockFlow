@model OrderItemViewModel

@{
    ViewData["Title"] = "Adicionar produto";
}

<h1>Adicionar produto ao carrinho</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddItem" asp-route-orderId="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group mb-3">
                <label asp-for="ProductVariantId" class="control-label"></label>
                <select asp-for="ProductVariantId" asp-items="Model.VariantOptions" class="form-select">
                    <option value="">Selecione</option>
                </select>
                <span asp-validation-for="ProductVariantId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
            {
                <div class="form-group mb-3">
                    <label asp-for="UnitPrice" class="control-label"></label>
                    <input asp-for="UnitPrice" class="form-control" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="UnitPrice" />
            }

            <div class="form-group">
                <input type="submit" value="Adicionar ao carrinho" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
