@model IReadOnlyList<ProductViewModel>

@{
    ViewData["Title"] = "Início";
    var apiBaseUrl = ViewBag.ApiBaseUrl as string ?? string.Empty;
}

<div class="home-banner mb-4 container-do-banner">
    <img src="~/images/home-banner.jpg"
         asp-append-version="true"
         class="img-fluid w-100 rounded"
         alt="Banner de loja com produtos em prateleiras." />
</div>

<div class="home-produtos">
    <h3><i class="bi bi-star-fill titulo-icon" aria-hidden="true"></i>Melhores produtos:</h3>

    @if (Model.Count == 0)
    {
        <p>Nenhum produto cadastrado.</p>
    }
    else
    {
        <div class="produtos-cards">
            @foreach (var product in Model)
            {
                var images = product.Images ?? [];
                var mainImage = images.FirstOrDefault(image => image.IsMain) ?? images.FirstOrDefault();

                <div class="produto-card">
                    @if (mainImage is not null)
                    {
                        <img src="@(apiBaseUrl + mainImage.ImageUrl)" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="produto-sem-imagem">Sem imagem</div>
                    }

                    <h2>@product.Name</h2>
                    <p class="produto-preco">@product.SalePrice.ToString("C")</p>
                    <a class="produto-botao" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">
                        <i class="bi bi-eye botao-icon" aria-hidden="true"></i>Detalhes
                    </a>
                </div>
            }
        </div>
    }
</div>