@model CustomerProfileViewModel

@{
    ViewData["Title"] = "Meu perfil";
}

<h1>Meu perfil</h1>

<div class="mb-3">
    <a asp-controller="Orders" asp-action="History" class="btn btn-secondary">Ver histórico de compras</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h4>Dados</h4>
        <dl class="row mb-0">
            <dt class="col-sm-2">Nome</dt>
            <dd class="col-sm-10">@Model.User.Name</dd>
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.User.Email</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Endereços</h4>
            <a asp-action="AddAddress" class="btn btn-primary">Adicionar endereço</a>
        </div>

        @if (!Model.Addresses.Any())
        {
            <p class="mb-0">Nenhum endereço cadastrado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Rua</th>
                            <th>Número</th>
                            <th>Cidade</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var address in Model.Addresses)
                        {
                            <tr>
                                <td>@address.Street</td>
                                <td>@address.Number</td>
                                <td>@address.City</td>
                                <td>@address.State</td>
                                <td class="text-end">
                                    <a asp-action="EditAddress" asp-route-id="@address.Id" class="btn btn-sm btn-secondary">Editar</a>
                                    <form asp-action="DeleteAddress" asp-route-id="@address.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
