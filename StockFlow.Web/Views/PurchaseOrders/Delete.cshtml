@model PurchaseOrderViewModel

@{
    ViewData["Title"] = "Excluir pedido de compra";
}

<h1>Excluir pedido de compra</h1>

<div class="card">
    <div class="card-body">
        <h3>Tem certeza que deseja excluir este pedido de compra?</h3>
        <h4>Pedido de compra</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-2">Fornecedor</dt>
            <dd class="col-sm-10">@Model.SupplierName</dd>

            <dt class="col-sm-2">Status</dt>
            <dd class="col-sm-10">@Model.Status</dd>

            <dt class="col-sm-2">Data</dt>
            <dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-2">Total</dt>
            <dd class="col-sm-10 fw-bold">R$ @Model.Total.ToString("F2")</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Excluir" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>
