@model PurchaseOrderItemViewModel

@{
    ViewData["Title"] = "Adicionar item";
}

<h1>Adicionar item</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddItem" method="post">
            <input type="hidden" asp-for="PurchaseOrderId" />

            <div class="form-group mb-3">
                <label asp-for="ProductVariantId" class="control-label"></label>
                <select asp-for="ProductVariantId" asp-items="Model.VariantOptions" class="form-select"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" type="number" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="UnitCost" class="control-label"></label>
                <input asp-for="UnitCost" class="form-control" type="number" step="0.01" />
            </div>

            <div class="form-group">
                <input type="submit" value="Salvar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-route-id="@Model.PurchaseOrderId">Voltar</a>
</div>