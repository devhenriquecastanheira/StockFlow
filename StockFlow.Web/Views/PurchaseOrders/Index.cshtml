@model List<PurchaseOrderViewModel>

@{
    ViewData["Title"] = "Pedidos de compra";
}

<h1>Pedidos de compra</h1>

<p>
    <a asp-action="Create">Novo pedido de compra</a>
</p>

@if (Model.Count == 0)
{
    <p>Nenhum pedido cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Fornecedor</th>
                <th>Status</th>
                <th>Data</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.SupplierName</td>
                    <td>@order.Status</td>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">R$ @order.Total.ToString("F2")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id">Detalhes</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
