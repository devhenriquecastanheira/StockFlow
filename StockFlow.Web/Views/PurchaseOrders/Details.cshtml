@model PurchaseOrderViewModel

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes</h1>

<div>
    <h4>Pedido de compra</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Fornecedor</dt>
        <dd class="col-sm-10">@Model.SupplierName</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10 fw-bold">R$ @Model.Total.ToString("F2")</dd>
    </dl>

    @if (Model.Status == PurchaseOrderStatusViewModel.Pending)
    {
        <form asp-action="Receive" asp-route-id="@Model.Id" method="post" class="mb-3">
            <div class="form-group mb-2">
                <label asp-for="WarehouseId"></label>
                <select asp-for="WarehouseId" asp-items="Model.WarehouseOptions" class="form-select"></select>
            </div>

            <button type="submit" class="btn btn-success">Receber ordem</button>
        </form>
    }

    @if (Model.Items.Count == 0)
    {
        <p>Nenhum item adicionado.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Produto</th>
                    <th>Tamanho</th>
                    <th>Cor</th>
                    <th class="text-end">Quantidade</th>
                    <th class="text-end">Custo unitário</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Size</td>
                        <td>@item.Color</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">R$ @item.UnitCost.ToString("F2")</td>
                        <td class="text-end fw-bold">R$ @item.SubTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div>
    @if (Model.Status == PurchaseOrderStatusViewModel.Pending)
    {
        <a asp-action="AddItem" asp-route-purchaseOrderId="@Model.Id">Adicionar item</a>
        <span>|</span>
    }

    <a asp-action="Index">Voltar</a>
</div>
