@model ProductViewModel

@{
    ViewData["Title"] = "Variantes";
}

<h1>Variantes</h1>

<div class="card">
    <div class="card-body">
    <h4>@Model.Name</h4>
    <hr />

    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
    {
        <p>
            <a asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-primary">Nova variante</a>
        </p>
    }
    else if (User.IsInRole("Cliente"))
    {
        <p>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-primary">Ver carrinho</a>
        </p>
    }

    @if (Model.Variants.Count == 0)
    {
        <p>Nenhuma variante cadastrada.</p>
    }
    else
    {
        <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Tamanho</th>
                    <th>Cor</th>
                    @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                    {
                        <th>Estoque mínimo</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model.Variants)
                {
                    <tr>
                        <td>@variant.Sku</td>
                        <td>@variant.Size</td>
                        <td>@variant.Color</td>
                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <td>@variant.MinimumStockLevel</td>
                        }
                        <td>
                            @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                            {
                                <a asp-action="Edit" asp-route-id="@variant.Id" class="btn btn-sm btn-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@variant.Id" class="btn btn-sm btn-danger">Excluir</a>
                            }
                            else
                            {
                                <form asp-controller="Cart" asp-action="AddItem" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="ProductId" value="@Model.Id" />
                                    <input type="hidden" name="ProductVariantId" value="@variant.Id" />
                                    <input type="number" name="Quantity" value="1" min="1" class="form-control form-control-sm" style="width: 80px;" />
                                    <button type="submit" class="btn btn-sm btn-primary">Adicionar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    </div>
</div>

<div class="mt-3">
    <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
