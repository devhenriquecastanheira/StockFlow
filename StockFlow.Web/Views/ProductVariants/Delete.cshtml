@model ProductVariantViewModel

@{
    ViewData["Title"] = "Excluir variante";
}

<h1>Excluir variante</h1>

<h3>Tem certeza que deseja excluir esta variante?</h3>

<div>
    <h4>@Model.ProductName</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">SKU</dt>
        <dd class="col-sm-10">@Model.Sku</dd>
        <dt class="col-sm-2">Tamanho</dt>
        <dd class="col-sm-10">@Model.Size</dd>
        <dt class="col-sm-2">Cor</dt>
        <dd class="col-sm-10">@Model.Color</dd>
        <dt class="col-sm-2">Estoque mínimo</dt>
        <dd class="col-sm-10">@Model.MinimumStockLevel</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ProductId" />

        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index" asp-route-productId="@Model.ProductId">Voltar</a>
    </form>
</div>