@model ProductVariantViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ProductId" />
<input type="hidden" asp-for="ProductName" />

<div class="form-group mb-3">
    <label asp-for="Size" class="control-label"></label>
    <input asp-for="Size" class="form-control" autocomplete="off" />
    <span asp-validation-for="Size" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Color" class="control-label"></label>
    <input asp-for="Color" class="form-control" autocomplete="off" />
    <span asp-validation-for="Color" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Sku" class="control-label"></label>
    <input asp-for="Sku" class="form-control" autocomplete="off" />
    <span asp-validation-for="Sku" class="text-danger"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="MinimumStockLevel" class="control-label"></label>
    <input asp-for="MinimumStockLevel" class="form-control" type="number" />
    <span asp-validation-for="MinimumStockLevel" class="text-danger"></span>
</div>