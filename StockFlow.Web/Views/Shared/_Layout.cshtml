<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - StockFlow</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <img src="~/images/logo.png" alt="Logo" style="height: 40px; margin-right: 10px;" />
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    StockFlow
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin") || User.IsInRole("Operador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-grid nav-icon" aria-hidden="true"></i>Categorias
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-box-seam nav-icon" aria-hidden="true"></i>Produtos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Suppliers" asp-action="Index">
                                    <i class="bi bi-truck nav-icon" aria-hidden="true"></i>Fornecedores
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Stock" asp-action="Index">
                                    <i class="bi bi-clipboard-data nav-icon" aria-hidden="true"></i>Estoque
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-receipt nav-icon" aria-hidden="true"></i>Pedidos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Warehouses" asp-action="Index">
                                    <i class="bi bi-buildings nav-icon" aria-hidden="true"></i>Armazéns
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="PurchaseOrders" asp-action="Index">
                                    <i class="bi bi-bag-check nav-icon" aria-hidden="true"></i>Pedidos de compra
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Tags" asp-action="Index">
                                    <i class="bi bi-tags nav-icon" aria-hidden="true"></i>Tags
                                </a>
                            </li>
                        }
                        @if (!User.IsInRole("Admin") && !User.IsInRole("Operador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-shop nav-icon" aria-hidden="true"></i>Catálogo
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart3 nav-icon" aria-hidden="true"></i>Carrinho
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Orders" asp-action="History">
                                    <i class="bi bi-bag-heart nav-icon" aria-hidden="true"></i>Minhas compras
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                @if (User.IsInRole("Cliente"))
                                {
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Customers" asp-action="Index">
                                        <i class="bi bi-person-circle nav-icon" aria-hidden="true"></i>@User.Identity.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="nav-link text-dark">
                                        <i class="bi bi-person nav-icon" aria-hidden="true"></i>@User.Identity.Name
                                    </span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link text-dark">
                                        <i class="bi bi-box-arrow-right nav-icon" aria-hidden="true"></i>Sair
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right nav-icon" aria-hidden="true"></i>Entrar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus nav-icon" aria-hidden="true"></i>Cadastrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
        @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <i class="bi bi-boxes footer-icon" aria-hidden="true"></i>&copy; 2026 - StockFlow
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
